config_version=5

[application]

config/name="BrotatoLike"
config/description="A Brotato-inspired top-down survivor"
config/version="0.1.0"
run/main_scene="res://scenes/game/Game.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[audio]

